{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DB: Start PostgreSQL (Docker)",
      "type": "shell",
      "command": "docker compose -f infrastructure/docker-compose.yml up -d postgres",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: npm install",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: npm run dev (port 5173)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Full stack: Docker Compose up (build)",
      "type": "shell",
      "command": "docker compose up --build -d",
      "options": { "cwd": "${workspaceFolder}/infrastructure" },
      "problemMatcher": []
    },
    {
      "label": "Full stack: Docker Compose down",
      "type": "shell",
      "command": "docker compose down",
      "options": { "cwd": "${workspaceFolder}/infrastructure" },
      "problemMatcher": []
    }
  ]
}
