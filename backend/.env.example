DB_URL=jdbc:postgresql://localhost:5432/freshmcalc
DB_USERNAME=freshmcalc
DB_PASSWORD=freshmcalc
SERVER_PORT=8080
JWT_SECRET=change-me-in-production-this-must-be-at-least-256-bits-long
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_TEST_MODE=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

# First admin account (created automatically on backend startup when both are set).
# After first login, you may remove ADMIN_PASSWORD. Use a strong password in production!
ADMIN_EMAIL=admin@freshmcalc.com
ADMIN_PASSWORD=Admin@123
ADMIN_FIRST_NAME=Admin

# Public URL used in password-reset emails (no trailing slash).
APP_PUBLIC_URL=http://localhost:5173

# Transactional email (optional). Leave MAIL_HOST empty to disable sending:
# the app runs normally and password-reset links are only written to the log
# when APP_MAIL_EXPOSE_RESET_LINK=true (local development).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@freshmcalc.com
APP_MAIL_EXPOSE_RESET_LINK=true
