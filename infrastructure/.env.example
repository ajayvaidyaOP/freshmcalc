# ---------------------------------------------------------------------------
# FreshmCalc — production stack settings (Docker Compose)
# Copy to .env on the server: cp .env.example .env
# NEVER commit .env (it is git-ignored).
# ---------------------------------------------------------------------------

DB_NAME=freshmcalc
DB_USERNAME=freshmcalc
# Local dev default. CHANGE THIS in production: openssl rand -base64 24
DB_PASSWORD=freshmcalc
# Postgres is published on 127.0.0.1 only (local admin access).
DB_PORT=5432

# Port for the internal frontend container (loopback only). Public entry is Nginx 80/443.
FRONTEND_PORT=5173

# 256+ bits: openssl rand -base64 48
JWT_SECRET=change-me-in-production-this-must-be-at-least-256-bits-long
JWT_EXPIRATION_MS=86400000

# Browser origins allowed to call the API. Same-origin behind Nginx is enough;
# add others only if you host the web app on a different domain.
CORS_ALLOWED_ORIGINS=http://localhost

# Razorpay — required for subscription checkout.
# Without keys the app runs, but the Subscribe button reports that payments
# are not configured (no plan is ever activated without a verified payment).
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_TEST_MODE=true

# First admin account (created on backend startup when both are set).
# After the first production login, remove ADMIN_PASSWORD and restart.
ADMIN_EMAIL=admin@freshmcalc.com
ADMIN_PASSWORD=Admin@123
ADMIN_FIRST_NAME=Admin
