# Java / Gradle
*.class
*.jar
*.war
*.ear
.gradle/
build/
out/
.idea/
*.iml
*.ipr
*.iws
# ...but the Gradle wrapper jar is committed on purpose so the build
# works without a local Gradle installation. (Do NOT add *.gradle here:
# it would ignore build.gradle / settings.gradle themselves.)
!**/gradle/wrapper/gradle-wrapper.jar

# Node / frontend
node_modules/
dist/
build/
.env
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE — personal settings ignored; shared launch/tasks/extensions are committed
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
*.swp
*.swo
.DS_Store

# OS
Thumbs.db

# Logs
*.log

# Backups
*.dump
*.backup
backups/

# Secrets
**/secrets.yml
**/credentials.yml

# Mobile signing material — never commit
*.jks
*.keystore
frontend/android/local.properties
frontend/android/app/google-services.json
frontend/ios/App/Podfile.lock
frontend/ios/App/App/public

# Postgres dumps (never commit customer data).
# Re-include the folder itself so the .gitkeep survives the backups/ rule above.
!infrastructure/backups/
infrastructure/backups/*
!infrastructure/backups/.gitkeep

# Sentry (if configured) and local tooling
.sentryclirc

# TLS material and the generated edge config (see infrastructure/scripts)
infrastructure/certbot/conf/*
!infrastructure/certbot/conf/.gitkeep
infrastructure/certbot/www/*
!infrastructure/certbot/www/.gitkeep
infrastructure/nginx/https.conf
